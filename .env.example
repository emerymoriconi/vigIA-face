# ==========================================================
#                   CONFIGURAÇÃO VIGIA-FACE (TEMPLATE)
# ==========================================================

# --- [ IDENTIFICAÇÃO DO DISPOSITIVO ] ---
# ID único para este dispositivo (ex: Sala-01, Portaria-Sul)
VIGIA_DEVICE_ID=nome-do-dispositivo

# --- [ SEGURANÇA E AUTENTICAÇÃO ] ---
# Chave Mestra AES-256 para criptografia de metadados
# Gere uma nova com: openssl rand -base64 32
VIGIA_MASTER_KEY=sua-chave-aqui

# Chave de API do Backend (deve coincidir com VITE_VIGIA_API_KEY)
VIGIA_API_KEY=sua-api-key-aqui

# Habilitar documentação Swagger em /docs (true/false)
VIGIA_ENABLE_DOCS=true


# --- [ FRONTEND / DASHBOARD ] ---
# Estas variáveis são lidas pelo React (Vite)
VITE_VIGIA_API_KEY=sua-api-key-aqui
VITE_WS_URL="ws://localhost:8000/ws"

# --- [ IA E MODELOS ] ---
# Caminhos para os modelos ONNX
DETECTOR_MODEL=weights/det_10g.onnx
RECOGNIZER_MODEL=weights/w600k_mbf.onnx

# Sensibilidade da Inferência (0.0 a 1.0) - Quanto maior, mais rigoroso
AI_THRESHOLD=0.3

# Tempo de espera (segundos) antes de registrar a mesma pessoa novamente
HISTORY_COOLDOWN=60

# --- [ CÂMERA (opcional) ] ---
# Por padrão o sistema autodetecta a câmera (CSI ou USB) na inicialização.
# Se a autodetecção falhar nesta Pi específica, force manualmente com as duas
# variáveis abaixo (descubra o índice/tipo correto olhando os logs de detecção):
# CAMERA_SOURCE=0
# CAMERA_TYPE=CSI


# --- [ BANCO DE DADOS VETORIAL (QDRANT) ] ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Caminho de armazenamento (deixe vazio para modo Servidor/Docker)
QDRANT_PATH=

# Limite para alerta de uso de disco (GB)
QDRANT_VOLUME_LIMIT_GB=10.0
